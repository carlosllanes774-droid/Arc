# Arc production environment (copy to .env locally — never commit .env)
NODE_ENV=production

# Render / public URL (comma-separated for multiple origins)
ARC_FRONTEND_ORIGIN=https://nutriai-qevt.onrender.com

# OpenAI
OPENAI_API_KEY=

# Nutrition providers
SPOONACULAR_API_KEY=
EDAMAM_APP_ID=
EDAMAM_API_KEY=
USDA_API_KEY=

# Supabase (Auth + profiles)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required for in-app account deletion (Dashboard → Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: US grocery pricing
KROGER_CLIENT_ID=
KROGER_SECRET=

# Sentry (from sentry.io → Project → Client Keys → DSN)
SENTRY_DSN=

# Support email shown in Settings → Contact
ARC_CONTACT_EMAIL=hello@example.com

# Optional: verbose server pipeline logs
# ARC_PIPELINE_TRACE_VERBOSE=1
